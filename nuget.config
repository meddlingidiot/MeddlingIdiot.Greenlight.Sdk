<?xml version="1.0" encoding="utf-8"?>
<!--
  Spelled out rather than inherited: the machine-wide config on some of our boxes does not
  list nuget.org, and a public SDK that only restores where it was written is no use to
  anyone. Everything here comes from nuget.org and nowhere else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
